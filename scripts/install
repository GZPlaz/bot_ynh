#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Installing the bot code and Python dependencies..."
_siegebot_install_code

ynh_script_progression "Writing configuration..."
ynh_config_add --template=".env" --destination="$install_dir/.env"
chmod 600 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"
chown -R "$app:$app" "$data_dir"
chmod 750 "$data_dir"

ynh_script_progression "Configuring NGINX and systemd..."
ynh_config_add_nginx
ynh_config_add_systemd
yunohost service add "$app" --description="SiegeBot Discord bot"

ynh_script_progression "Starting the bot..."
ynh_systemctl --service="$app" --action="start"

ynh_script_progression "Installation of $app completed"
